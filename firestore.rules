rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.email is string &&
               data.email.size() <= 256;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
      
      // Cart items sub-collection
      match /cart/{itemId} {
        function isValidCartItem(data) {
          return data.bookId is string && 
                 data.bookId.size() <= 128 &&
                 data.quantity is int &&
                 data.quantity > 0 &&
                 data.quantity <= 99;
        }

        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCartItem(incoming()) && isValidId(itemId);
        allow update: if isOwner(userId) && isValidCartItem(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['quantity']);
        allow delete: if isOwner(userId);
      }
    }

    // Orders Rules
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.userId == request.auth.uid &&
               data.status in ['pending', 'completed', 'cancelled'] &&
               data.total is number &&
               data.total >= 0;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().createdAt == request.time;
    }
  }
}
